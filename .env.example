# Required for the main OpenAI-based CLI (index.ts)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: used by googleSearch tool (functions/googleSearch.ts)
SERPAPI_API_KEY=your_serpapi_api_key_here

# Optional: used by claude.ts runner
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional runtime settings for swiss-army-knife (index.ts)
SAK_MODEL=o3-mini
SAK_CONTEXT_TRIGGER_TOKENS=28000
SAK_KEEP_RECENT_MESSAGES=12
SAK_SESSION_ID=default
SAK_ENABLE_LOGGING=true
SAK_LOG_DIR=.sak-logs
SAK_MEMORY_DIR=.sak-memory
SAK_PROMPT_PLACEHOLDER=Write tests for @filename
